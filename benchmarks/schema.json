{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotoba-veil.local/schemas/benchmark-sample.json",
  "title": "Kotoba Veil benchmark sample",
  "type": "object",
  "required": ["id", "source", "text", "entities"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "default": "ja"},
    "split": {"enum": ["train", "dev", "test", "validation"], "default": "test"},
    "source": {"enum": ["synthetic", "licensed", "internal"]},
    "generator_version": {"type": ["string", "null"]},
    "template_id": {"type": ["string", "null"]},
    "text": {"type": "string"},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/span"}
    },
    "source_entities": {
      "type": "array", "default": [],
      "items": {"$ref": "#/$defs/sourceSpan"}
    },
    "dictionary_terms": {
      "type": "array",
      "items": {"$ref": "#/$defs/dictionaryTerm"},
      "default": []
    },
    "enabled_entities": {
      "type": ["array", "null"],
      "items": {"$ref": "#/$defs/entityType"}
    },
    "tags": {"type": "array", "items": {"type": "string"}, "default": []},
    "notes": {"type": "string", "default": ""}
  },
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "required": ["entity_type", "start", "end", "text"],
      "properties": {
        "entity_type": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "entityType": {
      "enum": ["PERSON", "ORGANIZATION", "LOCATION", "ADDRESS", "PHONE_NUMBER", "POSTAL_CODE", "EMAIL_ADDRESS", "PERSONAL_ID", "DRIVER_LICENSE", "BANK_ACCOUNT", "CREDIT_CARD", "DATE_TIME", "URL", "IP_ADDRESS", "CUSTOM"]
    },
    "span": {
      "type": "object",
      "required": ["entity_type", "start", "end", "text"],
      "properties": {
        "entity_type": {"$ref": "#/$defs/entityType"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "dictionaryTerm": {
      "type": "object",
      "required": ["term"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "entity_type": {"$ref": "#/$defs/entityType"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
